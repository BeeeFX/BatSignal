<Window x:Class="BatSignal.App.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="BatSignal" Width="380" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource Bs.Background}" Foreground="{DynamicResource Bs.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Bs.Muted}" />
    </Style>

    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Bs.Secondary}" />
      <Setter Property="Margin" Value="2,14,0,6" />
    </Style>

    <!-- Square glyph button (refresh, settings, back, move up/down) -->
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource Bs.Text}" />
      <Setter Property="Background" Value="{DynamicResource Bs.Surface}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bs.Hover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GhostIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Text button in the same style (Exit, Reset) -->
    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bs.Hover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Device mark that opens the icon picker -->
    <Style x:Key="MarkToggle" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bg" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource Bs.Background}"
                    BorderBrush="Transparent" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Bs.Border}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Bs.Text}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One icon in the picker -->
    <Style x:Key="IconChoice" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bg" Width="34" Height="34" CornerRadius="6" Background="{DynamicResource Bs.Background}"
                    BorderBrush="Transparent" BorderThickness="1" Margin="0,0,6,6">
              <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                         Foreground="{DynamicResource Bs.Text}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bs.Hover}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Bs.Text}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Text that looks like a label until hovered or focused (device names), or a normal field (labels) -->
    <Style x:Key="InlineText" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Bs.Text}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Bs.Text}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Bs.Accent}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="3,3" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="5">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Bs.InputBorder}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bs.Input}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Bs.Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource InlineText}">
      <Setter Property="Background" Value="{DynamicResource Bs.Input}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Bs.InputBorder}" />
    </Style>

    <!-- On/off switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                      BorderBrush="{DynamicResource Bs.Secondary}" Background="Transparent" />
              <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource Bs.Secondary}"
                       HorizontalAlignment="Left" Margin="4,0,0,0" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Knob" Property="Width" Value="14" />
                <Setter TargetName="Knob" Property="Height" Value="14" />
                <Setter TargetName="Knob" Property="Margin" Value="3,0,0,0" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Bs.Accent}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Bs.Accent}" />
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Bs.OnAccent}" />
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Drop-down list -->
    <Style x:Key="Combo" TargetType="ComboBox">
      <Setter Property="Height" Value="32" />
      <Setter Property="Foreground" Value="{DynamicResource Bs.Text}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Bs.Text}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="Bd" CornerRadius="4" Padding="10,6" Background="Transparent">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bs.Surface}" />
                    </Trigger>
                    <Trigger Property="IsHighlighted" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bs.Hover}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{DynamicResource Bs.Input}" BorderBrush="{DynamicResource Bs.InputBorder}"
                            BorderThickness="1" CornerRadius="5">
                      <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,0,10,0"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Bs.Secondary}" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bs.Hover}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                Margin="11,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
              <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                     Focusable="False" PopupAnimation="Fade">
                <Border Background="{DynamicResource Bs.Background}" BorderBrush="{DynamicResource Bs.Border}" BorderThickness="1"
                        CornerRadius="6" Padding="4" Margin="0,4,0,0"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- "Icon | Text label" segmented choice -->
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bg" CornerRadius="5" Padding="10,4" Background="{DynamicResource Bs.Background}"
                    BorderBrush="Transparent" BorderThickness="1">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Bs.Text}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <!-- ============================== Devices page ============================== -->
    <DockPanel x:Name="DevicesPage" Margin="16,14,16,12">
      <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
        <TextBlock Text="Peripherals" FontWeight="SemiBold" />
        <TextBlock x:Name="UpdatedText" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>

      <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource Bs.Surface}"
              BorderBrush="{DynamicResource Bs.Accent}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
        <Grid>
          <TextBlock x:Name="UpdateText" VerticalAlignment="Center" FontSize="13" />
          <Button Style="{StaticResource TextButton}" Content="Restart to update" HorizontalAlignment="Right"
                  Background="{DynamicResource Bs.Background}" Click="Update_Click" />
        </Grid>
      </Border>

      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Bs.Border}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
        <Grid>
          <TextBlock x:Name="AlertText" FontSize="12" Foreground="{DynamicResource Bs.Secondary}" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh now" Click="Refresh_Click" />
            <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Click="OpenSettings_Click" Margin="6,0,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <StackPanel>
        <TextBlock x:Name="EmptyText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,12"
                   Foreground="{DynamicResource Bs.Secondary}"
                   Text="No devices yet. Plug in a Logitech receiver, or pair a Bluetooth device that reports its battery." />
        <ItemsControl x:Name="DeviceList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource Bs.Border}" BorderThickness="0,1,0,0" Padding="0,11">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="64" />
                  </Grid.ColumnDefinitions>
                  <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Bs.Surface}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Mark}" FontFamily="{Binding MarkFont}" FontSize="{Binding MarkSize}" FontWeight="{Binding MarkWeight}"
                               Foreground="{DynamicResource Bs.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,1,0,0" />
                    <Grid Height="6" Margin="0,7,0,0" Visibility="{Binding BarVisibility}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding Fill}" />
                        <ColumnDefinition Width="{Binding Rest}" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.ColumnSpan="2" CornerRadius="3" Background="{DynamicResource Bs.Track}" />
                      <Border CornerRadius="3" Background="{Binding LevelBrush}" />
                    </Grid>
                  </StackPanel>
                  <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PercentText}" FontSize="15" FontWeight="SemiBold" Foreground="{Binding LevelBrush}" />
                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{Binding LevelBrush}"
                               Margin="3,0,0,0" VerticalAlignment="Center" Visibility="{Binding BoltVisibility}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DockPanel>

    <!-- ============================== Settings page ============================== -->
    <DockPanel x:Name="SettingsPage" Margin="10,10,16,12" Visibility="Collapsed">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2">
        <Button Style="{StaticResource GhostIconButton}" Content="&#xE72B;" ToolTip="Back" Click="Back_Click" />
        <TextBlock Text="Settings" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
      </StackPanel>

      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Bs.Border}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="6,8,0,0">
        <Grid>
          <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
          <Button Style="{StaticResource TextButton}" Content="Exit BatSignal" HorizontalAlignment="Right" Click="Exit_Click" />
        </Grid>
      </Border>

      <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Hidden" MaxHeight="700" Margin="6,0,0,0">
        <StackPanel Margin="0,0,2,0">
          <TextBlock Text="Devices" Style="{StaticResource Section}" Margin="2,4,0,2" />
          <TextBlock Style="{StaticResource Caption}" Margin="2,0,0,8" TextWrapping="Wrap"
                     Text="Click a name to rename it, or an icon to change it. The switch shows or hides a device." />
          <ItemsControl x:Name="CustomizeList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource Bs.Surface}" CornerRadius="8" Padding="8,8,10,8" Margin="0,0,0,6">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ToggleButton Style="{StaticResource MarkToggle}" IsChecked="{Binding PickerOpen}" ToolTip="Change icon"
                                    Opacity="{Binding RowOpacity}">
                        <TextBlock Text="{Binding Mark}" FontFamily="{Binding MarkFont}" FontSize="{Binding MarkSize}" FontWeight="{Binding MarkWeight}"
                                   Foreground="{DynamicResource Bs.Text}" />
                      </ToggleButton>
                      <StackPanel Grid.Column="1" Margin="4,0,6,0" VerticalAlignment="Center" Opacity="{Binding RowOpacity}">
                        <TextBox Style="{StaticResource InlineText}" Text="{Binding DisplayName, UpdateSourceTrigger=LostFocus}"
                                 MaxLength="40" ToolTip="Click to rename" KeyDown="Name_KeyDown" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="9,0,0,0" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Show}" VerticalAlignment="Center"
                                ToolTip="Show on the taskbar and in this panel" />
                      <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="6,0,-4,0">
                        <Button Style="{StaticResource GhostIconButton}" Width="22" Height="18" FontSize="9" Content="&#xE70E;"
                                Foreground="{DynamicResource Bs.Muted}" ToolTip="Move up" Click="MoveUp_Click" />
                        <Button Style="{StaticResource GhostIconButton}" Width="22" Height="18" FontSize="9" Content="&#xE70D;"
                                Foreground="{DynamicResource Bs.Muted}" ToolTip="Move down" Click="MoveDown_Click" />
                      </StackPanel>
                    </Grid>

                    <StackPanel Visibility="{Binding PickerVisibility}" Margin="0,10,0,0">
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Style="{StaticResource Segment}" Content="Icon" IsChecked="{Binding UseIcon}" />
                        <RadioButton Style="{StaticResource Segment}" Content="Text label" IsChecked="{Binding UseLabel}" Margin="6,0,0,0" />
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding IconChoices}" Visibility="{Binding IconPanelVisibility}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <RadioButton Style="{StaticResource IconChoice}" IsChecked="{Binding IsSelected}" ToolTip="{Binding Name}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <StackPanel Orientation="Horizontal" Visibility="{Binding LabelPanelVisibility}" Margin="0,0,0,6">
                        <TextBox Style="{StaticResource Field}" Width="80" MaxLength="4" CharacterCasing="Upper"
                                 Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Caption}" Text="Up to 4 characters, shown instead of an icon" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Width="170" />
                      </StackPanel>
                      <Button Style="{StaticResource TextButton}" Content="Reset to default" HorizontalAlignment="Left" Margin="0,4,0,0"
                              Background="{DynamicResource Bs.Background}" Click="Reset_Click" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="General" Style="{StaticResource Section}" />
          <Border Background="{DynamicResource Bs.Surface}" CornerRadius="8" Padding="12,4">
            <StackPanel>
              <Grid Margin="0,6">
                <TextBlock Text="Show battery in" VerticalAlignment="Center" />
                <ComboBox x:Name="ModeBox" Style="{StaticResource Combo}" HorizontalAlignment="Right" Width="170" SelectionChanged="Mode_Changed">
                  <ComboBoxItem Content="Taskbar" />
                  <ComboBoxItem Content="Notification area" />
                </ComboBox>
              </Grid>
              <Border Height="1" Background="{DynamicResource Bs.Border}" />
              <Grid Margin="0,6">
                <TextBlock Text="Low-battery alert" VerticalAlignment="Center" />
                <ComboBox x:Name="AlertBox" Style="{StaticResource Combo}" HorizontalAlignment="Right" Width="170" SelectionChanged="Alert_Changed" />
              </Grid>
              <Border Height="1" Background="{DynamicResource Bs.Border}" />
              <Grid Margin="0,10">
                <TextBlock Text="Start with Windows" VerticalAlignment="Center" />
                <CheckBox x:Name="AutostartBox" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Autostart_Click" />
              </Grid>
              <Border Height="1" Background="{DynamicResource Bs.Border}" />
              <Grid Margin="0,6">
                <TextBlock Text="Notifications" VerticalAlignment="Center" />
                <Button Style="{StaticResource TextButton}" Content="Send a test alert" HorizontalAlignment="Right"
                        Background="{DynamicResource Bs.Background}" Click="TestAlert_Click" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
